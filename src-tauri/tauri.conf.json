{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.6.2",
  "identifier": "app.relay.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1436",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Relay",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://relay.localhost",
        "media-src": "'self' http://relay.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://relay.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "A chat client for your models",
    "longDescription": "Relay talks to local models (Ollama, LM Studio, llama.cpp) and any OpenAI-compatible endpoint, and lives in the Holster dock.",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCREM0RjFENEQ5NTExNTQKUldSVUVaVk5IVS9jcTV3VmcwK3M0NXl5R1lGcGlWNTZLSk1kUnlRTy9GZjdGbFRQbVdpNlZnV0kK",
      "endpoints": ["https://github.com/ManyGlue0/Relay/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
